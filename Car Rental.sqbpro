FROM Car WHERE Mileage &gt; 00000
ORDER BY Mileage DESC;</sql><sql name="Exercise2">SELECT Name, LicenseNb 
FROM Customer 
WHERE Phone IS NULL OR Email IS NULL;</sql><sql name="Exercise3">SELECT RentalID, Fuel_Qty, Return_Date
FROM Rental WHERE Fuel_Qty &lt; 0.25
ORDER BY Fuel_Qty ASC;</sql><sql name="Exercise4">SELECT EmployeeID,
COUNT(RentalID) AS Total_Processed 
FROM Rental
GROUP BY EmployeeID
ORDER BY Total_Processed DESC;</sql><current_tab id="2"/></tab_sql></sqlb_project>
